{
    "compilerOptions": {
        "target": "es2022",
        "moduleResolution": "node",
        "lib": [
            "es2022",
            "dom"
        ],
        "sourceMap": true,
        "outDir": "./.tmp/build/",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true
    },
    "files": [
        "./src/visual.ts"
    ]
}
