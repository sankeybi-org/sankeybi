{
  "dataRoles": [
    {
      "displayName": "Source",
      "displayNameKey": "role.source",
      "name": "source",
      "kind": "Grouping",
      "description": "The node a flow leaves. Each distinct value is one node.",
      "descriptionKey": "role.source.desc"
    },
    {
      "displayName": "Target",
      "displayNameKey": "role.target",
      "name": "target",
      "kind": "Grouping",
      "description": "The node a flow arrives at. A value used as both Source and Target is one node.",
      "descriptionKey": "role.target.desc"
    },
    {
      "displayName": "Value",
      "displayNameKey": "role.value",
      "name": "value",
      "kind": "Measure",
      "description": "The flow's size, as a measure. Sets flow width and the units of every total.",
      "descriptionKey": "role.value.desc"
    },
    {
      "displayName": "Flow type",
      "displayNameKey": "role.flowType",
      "name": "flowType",
      "kind": "Grouping",
      "description": "Splits a flow into one band per type, each with its own colour and legend entry.",
      "descriptionKey": "role.flowType.desc"
    },
    {
      "displayName": "Source port",
      "displayNameKey": "role.sourcePort",
      "name": "sourcePort",
      "kind": "Grouping",
      "description": "The face a flow leaves by: North, South, East or West. Blank follows Flow direction.",
      "descriptionKey": "role.sourcePort.desc"
    },
    {
      "displayName": "Target port",
      "displayNameKey": "role.targetPort",
      "name": "targetPort",
      "kind": "Grouping",
      "description": "The face a flow arrives at: North, South, East or West. Blank follows Flow direction.",
      "descriptionKey": "role.targetPort.desc"
    },
    {
      "displayName": "Source order",
      "displayNameKey": "role.sourceOrder",
      "name": "sourceOrder",
      "kind": "Grouping",
      "description": "Where the node sits in its column (or row), lowest first. Text groups nodes together.",
      "descriptionKey": "role.sourceOrder.desc"
    },
    {
      "displayName": "Target order",
      "displayNameKey": "role.targetOrder",
      "name": "targetOrder",
      "kind": "Grouping",
      "description": "Where the node sits in its column (or row), lowest first. Text groups nodes together.",
      "descriptionKey": "role.targetOrder.desc"
    },
    {
      "displayName": "Flow display order",
      "displayNameKey": "role.flowDisplayOrder",
      "name": "flowDisplayOrder",
      "kind": "GroupingOrMeasure",
      "description": "The order flow types stack in, lowest first. A column, or a measure returning a number.",
      "descriptionKey": "role.flowDisplayOrder.desc"
    },
    {
      "displayName": "Flow colour",
      "displayNameKey": "role.flowColour",
      "name": "flowColour",
      "kind": "GroupingOrMeasure",
      "description": "A colour for each flow type. A column of colours, or a measure returning one.",
      "descriptionKey": "role.flowColour.desc"
    },
    {
      "displayName": "Source icon",
      "displayNameKey": "role.sourceIcon",
      "name": "sourceIcon",
      "kind": "Grouping",
      "description": "A small SVG for the source node's label: SVG text or data URL, up to 20 KB.",
      "descriptionKey": "role.sourceIcon.desc"
    },
    {
      "displayName": "Target icon",
      "displayNameKey": "role.targetIcon",
      "name": "targetIcon",
      "kind": "Grouping",
      "description": "A small SVG for the target node's label: SVG text or data URL, up to 20 KB.",
      "descriptionKey": "role.targetIcon.desc"
    }
